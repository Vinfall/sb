{
    "version": "153.0.8010.37",
    "description": "Chromium fork based on Bromite with ad blocking and privacy enhancements",
    "homepage": "https://github.com/uazo/cromite",
    "license": {
        "identifier": "GPL-3.0-only",
        "url": "https://github.com/uazo/cromite/blob/master/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/uazo/cromite/releases/download/v153.0.8010.37-11507ac1061b5ea227806f5e84db5a57df6ccf6a/chrome-win.zip",
            "hash": "c95d1c679142a421df7de2cab090539ccb4158f69410dc1878735fb8f60e0fab"
        }
    },
    "extract_dir": "chrome-win",
    "env_set": {
        "CHROME_EXECUTABLE": "$dir\\chrome.exe"
    },
    "bin": [
        [
            "chrome.exe",
            "cromite",
            "--incognito"
        ]
    ],
    "shortcuts": [
        [
            "chrome.exe",
            "Cromite",
            "--incognito"
        ]
    ],
    "notes": "extras/cromite is recommended unless you hate persist 'User Data'.",
    "checkver": {
        "github": "https://github.com/uazo/cromite",
        "regex": "/releases/tag/v([\\d.]+)-(?<sha>[0-9a-f]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/uazo/cromite/releases/download/v$version-$matchSha/chrome-win.zip"
            }
        }
    }
}
